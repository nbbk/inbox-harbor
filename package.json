{
  "name": "inbox-harbor",
  "version": "1.0.0",
  "description": "InboxHarbor（收件港）- 本机优先的个人邮箱管理台",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "credentials": "node scripts/credentials.js",
